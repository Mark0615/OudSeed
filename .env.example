# GCP
GCP_PROJECT_ID=oudseed
BIGQUERY_DATASET=ads_pipeline
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.example.json

# Durable storage (Phase 2). Defaults to local SQLite when unset.
# Production uses a Cloud SQL PostgreSQL URL, e.g.
# postgresql+psycopg://USER:PASSWORD@/DBNAME?host=/cloudsql/INSTANCE_CONNECTION_NAME
DATABASE_URL=sqlite:///.local/oudseed.db

# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from src.storage.crypto import generate_key; print(generate_key())"
# Store the real value in Secret Manager; never commit it.
TOKEN_ENCRYPTION_KEY=your-fernet-key

# App base URL used to build OAuth redirect URLs (Phase 3 self-serve onboarding).
APP_BASE_URL=http://localhost:8765
# Signs the login session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=your-session-secret

# Meta Ads
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token
META_API_TIMEOUT_SECONDS=60
# Phase 3 self-serve OAuth: must match the Valid OAuth Redirect URI in the Meta app.
META_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/meta/callback

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-client-id
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
# Use the manager account customer ID without dashes when needed; leave empty for
# direct customer access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-login-customer-id

# Google sign-in + Google Ads OAuth (Phase 3). NEW "Web application" OAuth client
# (separate from the GOOGLE_ADS_* desktop client above). See docs/phase3_oauth_setup.md.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/google/callback
# Google Ads CONNECT callback (Phase 3 slice 2). Reuses the same Web client above;
# add this redirect URI to that client in Google Console. Distinct from sign-in.
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/google-ads/callback

# LINE Ads - future phase
LINE_ADS_ACCESS_KEY=your-line-access-key
LINE_ADS_SECRET_KEY=your-line-secret-key

# AI reports - future phase
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.2
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_TIMEOUT_SECONDS=60
AI_REPORT_TYPE=monthly
# Optional: read report type, delivery day, recipient, depth, and account-group
# defaults from config.clients[].report_schedules[].
AI_REPORT_SCHEDULE_ID=
AI_REPORT_LIST_SCHEDULES=false
# Leave AI_REPORT_PERIOD_START_DATE empty for scheduled reports.
# weekly defaults to the previous complete week; monthly defaults to the previous month.
AI_REPORT_PERIOD_START_DATE=
AI_REPORT_CLIENT_ID=your-client-id
AI_REPORT_LIMIT=10
AI_REPORT_DEPTH=standard
AI_REPORT_TIMEZONE=Asia/Taipei
# Optional safety controls for account-grouped report sends.
AI_REPORT_LIST_ACCOUNT_GROUPS=false
AI_REPORT_ACCOUNT_GROUP_NAME=
AI_REPORT_ACCOUNT_GROUP_LIMIT=

# Email delivery
AI_REPORT_EMAIL_TO=recipient@example.com
AI_REPORT_EMAIL_SUBJECT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender-email@example.com
SMTP_PASSWORD=your-smtp-or-app-password
SMTP_FROM_EMAIL=your-sender-email@example.com
SMTP_USE_TLS=true
